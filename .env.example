# Copie este archivo como ".env" y cambie los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta de Django. Genere una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL
DB_ENGINE=mysql
DB_NAME=aduana_db
DB_USER=aduana_user
DB_PASSWORD=escriba-aqui-la-clave-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Contraseña que tendrán los usuarios de prueba creados con "python manage.py cargar_datos"
DEMO_PASSWORD=escriba-aqui-una-clave-de-prueba
